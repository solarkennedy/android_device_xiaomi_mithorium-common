# xtra-daemon control
get_prop(hal_gnss_qti, xtra_control_prop);

# gnss reads boot_status_prop to check boot completion state
get_prop(hal_gnss_qti, boot_status_prop);

# [qmux] The gnss service preloads libqmi_force_ipcr.so (setenv in the gnss rc,
# init execs the HAL directly — no wrapper, because a HAL domain may not
# execute_no_trans a non-shell exec_type, hal_neverallows.te). The shim reads
# the qmux enable prop in-process and only forces ipc_router when it is set.
get_prop(hal_gnss_qti, vendor_qmux_prop)
