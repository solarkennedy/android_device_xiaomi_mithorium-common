# [qmux] The force-ipcr shim is LINKED into this binary (shared_libs in
# Android.bp), not LD_PRELOADed: init may never grant noatsecure (neverallow,
# b/140789528), so under Enforcing AT_SECURE=1 makes bionic silently scrub
# LD_PRELOAD. The shim is a runtime no-op unless qmux is enabled
# (ro.vendor.qmux.enable=1, set by libinit on pepito only, or an explicit
# persist.vendor.qmux.enable override); when qmux is on it routes the loc
# stack's QMI_LOC to the ipc_router modem. See PLAN-qmux-bridge.md.
service gnss_service /vendor/bin/hw/android.hardware.gnss@2.1-service-qti
    class hal
    user gps
    group system gps radio vendor_qti_diag
