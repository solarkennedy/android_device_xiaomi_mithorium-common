# Android-Go-style memory tweaks, individually user-toggleable (no root, no rebuild)
# via persist.gotweak.* properties. Values sourced from AOSP
# build/make/target/product/go_defaults_common.mk + go_defaults_common.prop.
# Default off everywhere; safe on any Mi8937/mithorium variant.
#
# on property: triggers evaluate current state at registration time (persist
# properties are already loaded by then), so these apply from the first boot
# after the toggle is set - no separate "apply" step needed beyond a reboot
# for the ro.*-backed ones.

# Master low-RAM flag. ro.* -> requires reboot. Side effect: AOSP drops any
# notLowRam="true" hardware feature the moment this is true, regardless of
# which handheld_core_hardware.xml is installed - on pepito's current
# manifest that's android.software.picture_in_picture, voice_recognizers,
# and activities_on_secondary_displays.
on property:persist.gotweak.low_ram=1
    setprop ro.config.low_ram true

# Trimmed Dalvik heap (128m/256m vs pepito's stock 192m/512m). Read once by
# zygote at its own startup -> requires reboot.
on property:persist.gotweak.heap_trim=1
    setprop dalvik.vm.heapgrowthlimit 128m
    setprop dalvik.vm.heapsize 256m

# lmkd low-memory-killer tuning. ro.* -> requires reboot (lmkd reads these at
# its own start; the ro.* lock means a later ctl.restart lmkd alone will not
# pick up a changed value within the same boot).
on property:persist.gotweak.lmk=1
    setprop ro.lmk.critical_upgrade true
    setprop ro.lmk.upgrade_pressure 40
    setprop ro.lmk.downgrade_pressure 60
    setprop ro.lmk.kill_heaviest_task false

# PackageManager dexopt tuning - not ro.*, applies at the next background
# dexopt/idle-maintenance window, no reboot required.
on property:persist.gotweak.dexopt=1
    setprop pm.dexopt.downgrade_after_inactive_days 10
    setprop pm.dexopt.shared quicken

# Both of these are pure outputs of GotweaksBatterySaverReceiver reacting to
# PowerManager.isPowerSaveMode() - neither is independently user-toggleable
# here. The Pepito Tweaks screen has two simple "participate in Battery
# Saver?" enable flags (persist.gotweak.battery_saver_cpu_enable,
# battery_saver_gpu_enable); the receiver ANDs each with the current Battery
# Saver state and writes the result here. Plain sysfs writes, live in both
# directions, no reboot needed.

# GPU max-clock cap: kgsl-3d0 has 6 pwrlevels (index 0 = fastest), pwrlevel 3
# = 375MHz vs the uncapped default's 475MHz ceiling (pwrlevel 0), confirmed
# live on the DUT (available_frequencies: 475/450/400/375/300/216 MHz).
on property:persist.gotweak.gpu_clock_cap=1
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 3

on property:persist.gotweak.gpu_clock_cap=0
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

# GPU min-clock floor (speed-for-battery, the inverse of the cap above):
# pwrlevel 3 = 375MHz floor vs the default floor of pwrlevel 5 (216MHz).
# Benched on Gold 2026-08-22 (interleaved A/B x5, perfectly repeatable):
# Settings-scroll worst frames 99th 31->25ms, GPU 90th/99th 21-22->15-16ms
# (~30% cut) - the ramp-from-216MHz cost on the first frames of every burst.
# Screen-on idle cost below measurement noise: min_pwrlevel only applies
# while the GPU is powered at all, so a static screen still power-collapses
# to zero. The real cost case is sustained light GPU load (video playback
# composition held at 375 instead of 216MHz) - hence a toggle, default off.
# Floor ONLY - stretching idle_timer added nothing to frames in the same
# A/B, so it stays at its default. Coexists with gpu_clock_cap=1: min=max=
# pwrlevel 3, kgsl handles that fine (GPU pinned at 375MHz).
on property:persist.gotweak.gpu_perf_floor=1
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 3

on property:persist.gotweak.gpu_perf_floor=0
    write /sys/class/kgsl/kgsl-3d0/min_pwrlevel 5

# CPU cluster hotplug: cpu0-3 are the 1.4GHz cluster, cpu4-7 the ~1.1GHz one
# (confirmed live on the DUT via scaling_max_freq). Offlining cpu1-3 pushes
# most load onto the lower-clocked, lower-voltage cluster. cpu0 must stay
# online: PSCI intermittently refuses to re-boot CPU0 after hotplug-off
# ("psci: failed to boot CPU0 (-22)", DUT 2026-07-12) and only a reboot
# recovers, so the boot CPU is never offlined.
on property:persist.gotweak.cpu_cluster_saver=1
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0

on property:persist.gotweak.cpu_cluster_saver=0
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
