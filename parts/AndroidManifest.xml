<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Life Mode. All signature-level or normal, so the platform cert grants
         them outright and no privapp-permissions allowlist entry is needed.
         MANAGE_NETWORK_POLICY is signature (NetworkPolicyManager.setRestrictBackground);
         WifiManager.setWifiEnabled() needs CHANGE_WIFI_STATE (normal) plus a
         privileged caller, which we satisfy via the platform key itself
         (WifiPermissionsUtil.isSignedWithPlatformKey).

         PowerManager.setPowerSaveModeEnabled() takes DEVICE_POWER *or*
         POWER_SAVER - deliberately DEVICE_POWER (signature|role), because
         POWER_SAVER is signature|PRIVILEGED and would drag in the privapp
         allowlist entry this app otherwise doesn't need. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MANAGE_NETWORK_POLICY" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Life Mode's GPS/Bluetooth levers. These two are the exception to the
         "no allowlist needed" rule above and lean on sharedUserId=android.uid.system
         instead: WRITE_SECURE_SETTINGS (LocationManager.setLocationEnabledForUser)
         is signature|privileged, and BLUETOOTH_CONNECT (BluetoothAdapter.disable)
         is a runtime permission that declaring alone does not grant. Sharing the
         system UID is what carries both - the same way LineageParts holds
         WRITE_SECURE_SETTINGS with no privapp entry of its own. Both call sites
         are wrapped in SecurityException guards regardless; see LifeModeController. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Greyscale (ColorDisplayManager.setSaturationLevel). Also signature|privileged,
         also carried by the system UID rather than a privapp entry. -->
    <uses-permission android:name="android.permission.CONTROL_DISPLAY_COLOR_TRANSFORMS" />

    <!-- Emergency-only recovery watchdog (EmergencyWatchdogController). Same
         system-UID-carries-it story as the Life Mode levers above: READ_PHONE_STATE
         is a runtime permission (needed to register the ServiceState TelephonyCallback)
         and READ_PRIVILEGED_PHONE_STATE is signature|privileged (un-sanitized
         ServiceState / full NetworkRegistrationInfo, so WWAN reg state is not redacted).
         Neither needs a privapp-permissions entry; sharedUserId=android.uid.system
         carries both. MODIFY_PHONE_STATE lets the nudge re-select the network
         (TelephonyManager.setNetworkSelectionModeAutomatic). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <!-- The watchdog debounce is a WAKEUP alarm (setExactAndAllowWhileIdle) so a
         screen-off/overnight stick is recovered on time; exact alarms need this
         since S. signature|privileged|appop - carried by the system UID. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- BLE-beacon notifications (BeaconNotifyController). BLUETOOTH_SCAN is a runtime
         permission; as with BLUETOOTH_CONNECT above, the system UID carries it.
         neverForLocation because we never derive location from a scan - and it keeps
         results flowing when Life Mode has location switched off. POST_NOTIFICATIONS
         is runtime too, same story. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The beacon scanner rides other apps' batch scans and finds out whether one is
         running by reading the Bluetooth service's dump (no query exists for it).
         dump() enforces DUMP; signature-level, carried by the system UID. -->
    <uses-permission android:name="android.permission.DUMP" />

    <protected-broadcast android:name="com.android.systemui.doze.pulse" />

    <application
        android:label="@string/device_settings_app_name"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase"
        android:enableOnBackInvokedCallback="true">

        <receiver android:name=".BootCompletedReceiver"
                  android:exported="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Safety power-on for the emergency-watchdog radio-cycle nudge. Manifest
             (not dynamic) so it still fires if XiaomiParts was killed during the
             radio-off window, guaranteeing the radio can't be stranded off. Not
             exported; triggered only by our own explicit alarm PendingIntent. -->
        <receiver android:name=".emergencywatchdog.RadioOnReceiver"
                  android:exported="false" />

        <activity
            android:name=".dirac.DiracActivity"
            android:exported="false"
            android:label="@string/dirac_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                       android:value="com.android.settings.category.ia.sound" />
            <meta-data android:name="com.android.settings.summary"
                       android:resource="@string/dirac_summary" />
        </activity>

        <service
            android:name=".doze.DozeService"
            android:permission="XiaomiDozeService"
            android:exported="true">
        </service>

        <!-- Life Mode's master switch. Disabled here so the tile never shows up
             in the QS editor on the sibling Mi8937 variants; BootCompletedReceiver
             enables it on pepito, where the feature belongs. -->
        <service
            android:name=".lifemode.LifeModeTile"
            android:enabled="false"
            android:label="@string/life_mode_tile_label"
            android:icon="@drawable/ic_life_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Long-press target for the Life Mode tile; trampolines into LineageParts'
             Life Mode screen. Exported because SystemUI starts it. Disabled here for
             the same reason the tile is, and enabled alongside it on pepito by
             BootCompletedReceiver - SystemUI resolves the long-press intent with
             flags 0, so while disabled it correctly does not resolve. -->
        <activity
            android:name=".lifemode.LifeModeSettingsActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/life_mode_tile_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".doze.DozeSettingsActivity"
            android:exported="false"
            android:label="@string/ambient_display_title">
            <intent-filter>
                <action android:name="org.lineageos.settings.device.DOZE_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Battery wear profile. Injected into Settings > Battery rather than System:
             CategoryKey.CATEGORY_BATTERY is hosted by PowerUsageSummary, which is a
             DashboardFragment, so it picks up injected tiles the same way the System
             dashboard does. It sat under System only because that was the category it
             was first given; nothing about it belongs there.

             No com.android.settings.icon on purpose: nothing else on the Battery page
             carries one (Battery usage, Battery Saver, Charging control and the rest
             are all flush left), so an icon here would make this the odd row out. It
             needed one under System, where every row has an icon and a tile without
             one renders with no icon gutter at all - the move is what made it moot.
             res/drawable/ic_battery_wear.xml is kept for if this ever moves back. -->
        <activity
            android:name=".batterywear.BatteryWearActivity"
            android:exported="false"
            android:label="@string/battery_wear_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category"
                       android:value="com.android.settings.category.ia.battery" />
            <meta-data android:name="com.android.settings.summary"
                       android:resource="@string/battery_wear_summary" />
        </activity>

    </application>
</manifest>
