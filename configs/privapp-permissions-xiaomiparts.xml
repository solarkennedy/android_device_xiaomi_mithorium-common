<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- XiaomiParts is a privileged system app (sharedUserId=android.uid.system).
         Every signature|privileged permission it requests must be listed here, or
         PermissionManagerService kills system_server at onSystemReady - a bootloop,
         not a soft failure. Runtime and plain signature permissions need no entry.
         DUMP: the beacon scanner reads the Bluetooth service's dump to learn whether
         another app's batch scan is running (BeaconNotifyController). -->
    <privapp-permissions package="org.lineageos.settings">
        <permission name="android.permission.DUMP"/>
    </privapp-permissions>
</permissions>
